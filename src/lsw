set -euo pipefail

LSW_VERSION="1.0.0"
LSW_BUILD="20260914"
LSW_DEFAULT_DISTRO="windows-11"

# Capture whether each dir was explicitly provided via env
_explicit_dirs=()
[[ -n "${LSW_CONFIG_DIR+x}" ]] && _explicit_dirs+=("LSW_CONFIG_DIR")
[[ -n "${LSW_DATA_DIR+x}" ]] && _explicit_dirs+=("LSW_DATA_DIR")
[[ -n "${LSW_DISTROS_DIR+x}" ]] && _explicit_dirs+=("LSW_DISTROS_DIR")

LSW_CONFIG_DIR="${LSW_CONFIG_DIR:-/etc/lsw}"
LSW_DATA_DIR="${LSW_DATA_DIR:-/var/lib/lsw}"
LSW_DISTROS_DIR="${LSW_DISTROS_DIR:-/var/lib/lsw/distros}"
LSW_PREFIX="${LSW_PREFIX:-/usr}"
LIB_DIR="${LSW_PREFIX}/lib/lsw"

# Resolve symlinks so 'lsw' works when reached through a PATH shim/symlink
_self="$(readlink -f "${BASH_SOURCE[0]:-}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_script_dir="$(cd "$(dirname "$_self")" && pwd)"
unset _self

# When running from a source tree, locate libraries relative to this script
if [[ ! -f "${LIB_DIR}/common.sh" ]]; then
    for _cand in "${_script_dir}/../lib" "${_script_dir}/lib"; do
        if [[ -f "${_cand}/common.sh" ]]; then
            LIB_DIR="$_cand"
            break
        fi
    done
    unset _cand
fi

# In an unpackaged source tree with no explicit dirs, use user-writable locations
if [[ ${#_explicit_dirs[@]} -eq 0 && "$LIB_DIR" != "${LSW_PREFIX}/lib/lsw" ]]; then
    LSW_DATA_DIR="${HOME}/.lsw/data"
    LSW_DISTROS_DIR="${HOME}/.lsw/distros"
    LSW_CONFIG_DIR="${HOME}/.lsw"
    # Keep everything rootless under $HOME/.lsw (runtime, symlinks, state)
    [[ "$LSW_PREFIX" == "/usr" ]] && LSW_PREFIX="${HOME}/.lsw"
fi
unset _explicit_dirs
mkdir -p "${LSW_DATA_DIR}" "${LSW_DISTROS_DIR}" "${LSW_CONFIG_DIR}" 2>/dev/null || true

# Edition scoping: a per-edition install (lsw-win-11 / lsw-win-10 package or
# /etc/lsw/edition file) restricts LSW to a single Windows version.
EDITION="${EDITION:-}"
if [[ -z "$EDITION" && -f "${LSW_CONFIG_DIR}/edition" ]]; then
    EDITION="$(head -n1 "${LSW_CONFIG_DIR}/edition" 2>/dev/null || true)"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

usage() {
    cat <<EOF
${BOLD}LSW - Linux Subsystem for Windows${NC} v${LSW_VERSION} (${LSW_BUILD})

${BOLD}Usage:${NC}
    lsw [options] [command]

${BOLD}Options:${NC}
    --install <distro>         Install a Windows version
    --list                     List installed Windows versions
    --list --online            List available Windows versions
    --set-default <distro>     Set the default Windows version
    --set-version <version>    Set Windows version compatibility
    --shutdown                 Terminate all running instances
    --terminate <distro>       Terminate a specific instance
    --unregister <distro>      Unregister and remove a Windows version
    --status <distro>          Show status of a Windows version
    --update <distro>          Update a Windows version
    --export <distro> <file>   Export a Windows version to a tar file
    --import <name> <file>     Import a Windows version from a tar file
    --config <distro> <file>   Configure a Windows version
    --version                  Show LSW version
    --help                     Show this help message

${BOLD}Running Windows commands:${NC}
    lsw <command> [args]       Run a Windows command
    lsw cmd                    Launch Windows Command Prompt
    lsw powershell             Launch PowerShell
    lsw explorer               Launch Windows Explorer (requires GUI bridge)
    lsw notepad                Launch Notepad

${BOLD}Examples:${NC}
    lsw --install windows-11
    lsw --list
    lsw cmd
    lsw notepad.exe myfile.txt
    lsw ping google.com

${BOLD}Package Managers:${NC}
    Arch Linux/Manjaro:  yay -S lsw-win-11   (or: lsw-win-10)
    Debian/Ubuntu:       (coming soon)
    Fedora/RHEL:         (coming soon)
    Homebrew:            (coming soon)

${BOLD}Quick start (any Linux):${NC}
    curl -fsSL https://raw.githubusercontent.com/Pratech1015/lsw/main/bootstrap/lsw-install.sh | bash
    lsw --install windows-11

${BOLD}Website:${NC}      https://github.com/Pratech1015/lsw
EOF
}

version_info() {
    echo "LSW version ${LSW_VERSION} (${LSW_BUILD})"
    echo "Target: ${EDITION:-Windows 11 (Build 22631)}"
    echo "NTLL compatibility layer"
}

die() {
    echo -e "${RED}error:${NC} $*" >&2
    exit 1
}

info() {
    echo -e "${GREEN}info:${NC} $*"
}

warn() {
    echo -e "${YELLOW}warning:${NC} $*"
}

check_root() {
    [[ $EUID -eq 0 ]] || die "this command must be run as root"
}

check_runtime() {
    command -v gcc &>/dev/null || die "gcc is required to build the LSW runtime (NTLL).\n  Arch:  sudo pacman -S gcc make\n  Debian: sudo apt install build-essential\n  Fedora: sudo dnf install gcc make"
}

load_config() {
    local config_file="${LSW_CONFIG_DIR}/lsw.conf"
    if [[ -f "$config_file" ]]; then
        # shellcheck source=/dev/null
        source "$config_file"
    fi
}

# Source library functions
if [[ -f "${LIB_DIR}/common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${LIB_DIR}/common.sh"
    # Available (enabled) distros - usually all known, or a single one when
    # this is an edition-scoped install (lsw-win-11 / lsw-win-10).
    if [[ -n "$EDITION" ]]; then
        if [[ -n "${DISTRO_BUILDS[$EDITION]:-}" ]]; then
            LSW_DEFAULT_DISTRO="$EDITION"
            ENABLED_DISTROS=("$EDITION")
        else
            echo -e "${YELLOW}warning:${NC} edition '${EDITION}' is not a known version" >&2
            EDITION=""
        fi
    fi
    if [[ -z "${ENABLED_DISTROS:-}" ]]; then
        # Keep a stable, sensible order
        ENABLED_DISTROS=("windows-11" "windows-10")
    fi
fi

# Parse arguments
ACTION=""
DISTRO=""
ONLINE=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --install)
            ACTION="install"
            shift
            DISTRO="${1:-}"
            [[ -z "$DISTRO" ]] && die "please specify a Windows version to install (e.g., windows-11)"
            shift
            ;;
        --list)
            ACTION="list"
            shift
            if [[ "${1:-}" == "--online" ]]; then
                ONLINE=true
                shift
            fi
            ;;
        --set-default)
            ACTION="set-default"
            shift
            DISTRO="${1:-}"
            [[ -z "$DISTRO" ]] && die "please specify a Windows version to set as default"
            shift
            ;;
        --set-version)
            ACTION="set-version"
            shift
            DISTRO="${1:-}"
            shift
            ;;
        --shutdown)
            ACTION="shutdown"
            shift
            ;;
        --terminate)
            ACTION="terminate"
            shift
            DISTRO="${1:-}"
            [[ -z "$DISTRO" ]] && die "please specify a Windows version to terminate"
            shift
            ;;
        --unregister)
            ACTION="unregister"
            shift
            DISTRO="${1:-}"
            [[ -z "$DISTRO" ]] && die "please specify a Windows version to unregister"
            shift
            ;;
        --status)
            ACTION="status"
            shift
            DISTRO="${1:-}"
            [[ $# -gt 0 && "${1:-}" != -* ]] && shift
            ;;
        --update)
            ACTION="update"
            shift
            DISTRO="${1:-}"
            [[ $# -gt 0 && "${1:-}" != -* ]] && shift
            ;;
        --export)
            ACTION="export"
            shift
            DISTRO="${1:-}"
            shift
            EXPORT_FILE="${1:-}"
            shift
            ;;
        --import)
            ACTION="import"
            shift
            DISTRO="${1:-}"
            shift
            IMPORT_FILE="${1:-}"
            shift
            ;;
        --config)
            ACTION="config"
            shift
            DISTRO="${1:-}"
            shift
            CONFIG_FILE="${1:-}"
            shift
            ;;
        --version)
            version_info
            exit 0
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --verbose|-v)
            VERBOSE=true
            shift
            ;;
        --)
            shift
            ACTION="run"
            break
            ;;
        -*)
            die "unknown option: $1\nRun 'lsw --help' for usage information."
            ;;
        *)
            ACTION="run"
            DISTRO=""
            set -- "$@"
            break
            ;;
    esac
done

# Dispatch actions
case "$ACTION" in
    install)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/install.sh"
        lsw_install "$DISTRO"
        ;;
    list)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_list "$ONLINE"
        ;;
    set-default)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_set_default "$DISTRO"
        ;;
    set-version)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_set_version "$DISTRO"
        ;;
    shutdown)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_shutdown
        ;;
    terminate)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_terminate "$DISTRO"
        ;;
    unregister)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_unregister "$DISTRO"
        ;;
    status)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_status "$DISTRO"
        ;;
    update)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/install.sh"
        lsw_update "$DISTRO"
        ;;
    export)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_export "$DISTRO" "${EXPORT_FILE:-}"
        ;;
    import)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_import "$DISTRO" "${IMPORT_FILE:-}"
        ;;
    config)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/manage.sh"
        lsw_config "$DISTRO" "${CONFIG_FILE:-}"
        ;;
    run)
        # shellcheck source=/dev/null
        source "${LIB_DIR}/runner.sh"
        lsw_run "$DISTRO" "$@"
        ;;
    *)
        usage
        exit 1
        ;;
esac
