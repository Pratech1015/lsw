# LSW configuration template (WSL-compatible format)
# This mirrors the /etc/wsl.conf format so Windows users feel at home.
# Copy to /etc/lsw/lsw.conf to use.

[boot]
systemd=false
command=""

[network]
hostname="Windows11"
generateResolvConf=true
generateHosts=true

[interop]
appendWindowsPath=true
enabled=true

[automount]
enabled=true
root="/mnt/"
options="metadata,umask=22,fmask=11"
# Host drive mounts exposed to the Windows environment as drive letters.
# Format: comma-separated "letter=hostpath" pairs. "d=/" maps D:\ to the
# Linux root, so every other partition is reachable from within Windows.
mounts="d=/"

[user]
default="Administrator"

[gui]
enabled=false
theme="dark"

[windows]
version="windows-11"
build="22631"
compatibility="high"
gpu_acceleration=true
audio=true